*.egg
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
venv/
.venv/
env/
.env

# Logs & Runtime Dumps
*.log
*.log.*
/tmp/
logs/

# Sensitive & Secret Files
*.pem
*.key
*.crt
*.pfx
*.p12
*.secret
credentials.json
secrets.json

